# Backend environment variables
# Copy to .env and fill in your values

PORT=3001
FRONTEND_URL=http://localhost:5173

# Explanation Layer API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub App Integration Keys
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Configurable Rate Limits (values in milliseconds / max requests)
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=100

RATE_LIMIT_SCAN_WINDOW_MS=300000
RATE_LIMIT_SCAN_MAX=5

RATE_LIMIT_PROJECT_WINDOW_MS=60000
RATE_LIMIT_PROJECT_MAX=10

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Database path for production
DB_DIR=/data/db
